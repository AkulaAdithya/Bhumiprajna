# Pravaah - Predictive Land Acquisition Intelligence Platform
# Environment Configuration Template
# Copy to .env and fill in actual values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:@localhost:5432/pravaah

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application
APP_NAME=Pravaah
APP_VERSION=1.0.0
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173

# Admin seed
ADMIN_EMAIL=admin@pravaah.gov.in
ADMIN_PASSWORD=Pravaah@2026
